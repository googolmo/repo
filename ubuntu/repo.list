# Linux package repository (one-line sources.list format)
# Install the keyring first:
#   sudo curl -fsSL https://repo-cr4.pages.dev/keys/repo.gpg \
#     -o /usr/share/keyrings/repo-archive-keyring.gpg
deb [arch=amd64,arm64 signed-by=/usr/share/keyrings/repo-archive-keyring.gpg] https://repo-cr4.pages.dev/ubuntu ubuntu22.04 main
