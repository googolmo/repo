# Linux package repository (one-line sources.list format)
# Install the keyring first:
#   sudo curl -fsSL https://googolmo.github.io/repo/keys/repo.gpg \
#     -o /usr/share/keyrings/repo-archive-keyring.gpg
deb [arch=amd64,arm64 signed-by=/usr/share/keyrings/repo-archive-keyring.gpg] https://googolmo.github.io/repo/ubuntu stable main
